<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_admin"
    app:startDestination="@id/adminDashboardFragment">

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.fcsibbul.ui.admin.dashboard.AdminDashboardFragment"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_adminDashboardFragment_to_postAnnouncementFragment"
            app:destination="@id/postAnnouncementFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_addExcoFragment"
            app:destination="@id/addExcoFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_postSongFragment"
            app:destination="@id/postSongFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_bibleVerseFragment"
            app:destination="@id/bibleVerseFragment" />
    </fragment>
    <fragment
        android:id="@+id/addExcoFragment"
        android:name="com.fcsibbul.ui.admin.addExco.AddExcoFragment"
        android:label="Add Exco"
        tools:layout="@layout/fragment_add_exco">
        <action
            android:id="@+id/action_addExcoFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/adminDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/postAnnouncementFragment"
        android:name="com.fcsibbul.ui.admin.postAnnouncement.PostAnnouncementFragment"
        android:label="@string/post_announcement"
        tools:layout="@layout/fragment_post_announcement">
        <action

            android:id="@+id/action_postAnnouncementFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/adminDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/postSongFragment"
        android:name="com.fcsibbul.ui.admin.postSong.PostSongFragment"
        android:label="Post a Song"
        tools:layout="@layout/fragment_post_song" />
    <fragment
        android:id="@+id/bibleVerseFragment"
        android:name="com.fcsibbul.ui.admin.postBibleVerse.PostBibleVerseFragment"
        android:label="Post a Bible Verse"
        tools:layout="@layout/fragment_post_bible_verse" />
</navigation>