<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dailyVerse.DailyBibleVerseFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_daily_verse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/card_background_color"
            app:cardCornerRadius="4dp"
            app:cardElevation="4dp"
            app:contentPaddingBottom="50dp"
            app:layout_constraintEnd_toStartOf="@+id/adView"
            app:layout_constraintStart_toEndOf="@+id/adView"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/daily_verse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing=".1"
                android:lineSpacingExtra="10dp"
                android:padding="6dp"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textIsSelectable="true"
                tools:text="@string/sample_bible_verse" />


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight=".2"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-9994399879531055/4563612338"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_daily_verse" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>