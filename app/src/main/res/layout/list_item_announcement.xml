<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="11dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:maxLines="1"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/primaryDarkColor"
            tools:text="FYB MEETING" />

        <TextView
            android:id="@+id/announcement_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/title"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/line_spacing"
            android:maxLines="3"
            android:textAlignment="textStart"
            android:textAppearance="?attr/textAppearanceBody1"
            tools:text="@string/fake_announcement" />


        <TextView
            android:id="@+id/announcement_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/announcement_details"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/recyclerview_padding"
            android:layout_marginTop="@dimen/recyclerview_padding"
            android:layout_marginEnd="@dimen/recyclerview_padding"
            android:layout_marginBottom="@dimen/recyclerview_padding"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="end"
            android:textColor="@color/primaryTextColor"
            tools:text="1st oct 2021" />

    </RelativeLayout>


</com.google.android.material.card.MaterialCardView>

